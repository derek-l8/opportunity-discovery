{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-feedback.schema.json",
  "title": "Reasoned private workspace feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recorded_at", "feedback"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "custom": {"type": "object"},
    "feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feedback_id", "opportunity_id", "action", "preference_signals"],
        "anyOf": [{"required": ["reason_code"]}, {"required": ["reason_text"]}],
        "properties": {
          "feedback_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-f]{32}$"},
          "action": {"enum": ["done", "delete"]},
          "reason_code": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "reason_text": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "preference_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "direction"],
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
                "direction": {"enum": ["prefer", "avoid"]},
                "custom": {"type": "object"}
              }
            }
          },
          "custom": {"type": "object"}
        }
      }
    }
  }
}
