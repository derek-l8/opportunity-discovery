{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunity-discovery/schemas/candidate.schema.json",
  "title": "Normalized public opportunity lead (unverified)",
  "type": "object",
  "required": [
    "opportunity_id",
    "lead_state",
    "title",
    "canonical_url",
    "remote_signal",
    "application_effort_estimate",
    "change_type",
    "first_seen",
    "last_seen",
    "duplicate_state",
    "possible_duplicate_ids",
    "provenance"
  ],
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "lead_state": {
      "enum": [
        "unverified-lead"
      ]
    },
    "organization": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "official_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_req_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_components": {
      "type": "object",
      "properties": {
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "remote_signal": {
      "enum": [
        "remote",
        "hybrid",
        "in-person",
        "unknown"
      ]
    },
    "season": {
      "type": [
        "string",
        "null"
      ]
    },
    "employment_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "engagement_type": {
      "enum": [
        "internship",
        "co-op",
        "contract",
        "research",
        "fellowship",
        "program",
        "event",
        "full-time",
        "unknown"
      ]
    },
    "career_stage": {
      "enum": [
        "student",
        "new-grad",
        "entry-level",
        "experienced",
        "unknown"
      ]
    },
    "required_degree": {
      "enum": [
        "high-school",
        "associate",
        "bachelors",
        "masters",
        "doctorate",
        "unknown"
      ]
    },
    "preferred_degree": {
      "enum": [
        "high-school",
        "associate",
        "bachelors",
        "masters",
        "doctorate",
        "unknown"
      ]
    },
    "experience_requirement": {
      "type": "object",
      "required": [
        "text",
        "minimum_years",
        "maximum_years"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "minimum_years": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_years": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "active_profile": {
      "enum": [
        "student-early-career",
        "new-grad",
        "all-opportunities"
      ]
    },
    "routing_state": {
      "enum": [
        "included",
        "excluded",
        "research_needed"
      ]
    },
    "eligibility_confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "profile_routes": {
      "type": "object",
      "required": [
        "student-early-career",
        "new-grad",
        "all-opportunities"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "routing_state",
          "eligibility_confidence",
          "reason_codes"
        ],
        "properties": {
          "routing_state": {
            "enum": [
              "included",
              "excluded",
              "research_needed"
            ]
          },
          "eligibility_confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "routing_reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_state": {
      "enum": [
        "unique",
        "possible_duplicate"
      ]
    },
    "possible_duplicate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "posted_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "stated_deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_timezone": {
      "type": "string"
    },
    "overview_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "program_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cycle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_start_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_end_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_state": {
      "enum": [
        "application-open",
        "notification-only",
        "closed",
        "unknown"
      ]
    },
    "requirements_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "compensation_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "relocation_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "description_excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "description_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "class_year_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "graduation_window_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "major_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_auth_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_application_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "application_effort_estimate": {
      "enum": [
        "quick",
        "moderate",
        "substantial",
        "unknown"
      ]
    },
    "role_family_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "object"
    },
    "score_components": {
      "type": "object"
    },
    "generic_score": {
      "type": "number"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_type": {
      "enum": [
        "new",
        "no-change",
        "reopened",
        "apparently-closed",
        "deadline-changed",
        "application-opened",
        "application-closed",
        "requirements-changed",
        "dates-changed",
        "location-changed",
        "materially-changed",
        "check-failed"
      ]
    },
    "change_events": {
      "type": "array",
      "items": {
        "enum": [
          "new",
          "no-change",
          "reopened",
          "apparently-closed",
          "deadline-changed",
          "application-opened",
          "application-closed",
          "requirements-changed",
          "dates-changed",
          "location-changed",
          "materially-changed",
          "check-failed"
        ]
      }
    },
    "active": {
      "type": "boolean"
    },
    "first_seen": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "last_changed": {
      "type": "string"
    },
    "last_successful_check": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "evidence"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "enum": [
              "source-stated",
              "inferred-signal",
              "unverified-lead",
              "unknown"
            ]
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          }
        }
      }
    },
    "source_constraints": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "evidence",
          "modality"
        ],
        "properties": {
          "kind": {
            "enum": [
              "graduation",
              "education",
              "professional-enrollment",
              "work-authorization",
              "security-clearance",
              "institution-region",
              "duration",
              "travel-funding"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "modality": {
            "enum": [
              "required",
              "preferred",
              "unspecified",
              "not-required"
            ]
          },
          "windows": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
              }
            }
          },
          "resolved": {
            "type": "boolean"
          },
          "degrees": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "enum": [
                "bachelors",
                "masters",
                "doctorate"
              ]
            }
          },
          "state": {
            "enum": [
              "enrolled",
              "completed",
              "unknown"
            ]
          },
          "exception": {
            "type": "string",
            "maxLength": 1000
          },
          "regions": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "enum": [
                "UK",
                "EU"
              ]
            }
          },
          "funding": {
            "enum": [
              "covered",
              "uncovered",
              "unknown"
            ]
          },
          "degree_operator": {
            "enum": [
              "any",
              "all",
              "unknown"
            ]
          },
          "study_progress": {
            "type": "boolean"
          },
          "conflicting_context": {
            "type": "boolean"
          },
          "extraction_incomplete": {
            "type": "boolean"
          }
        }
      },
      "description": "Null means extraction is unknown; an empty array records a successful empty constraint extraction."
    }
  }
}
