{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-review.schema.json",
  "title": "Private workspace review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_generation_id", "reviewed_at", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "custom": {"type": "object"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunity_id", "disposition", "reason_codes", "official_evidence", "verification", "eligibility"],
        "properties": {
          "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-f]{32}$"},
          "disposition": {"enum": ["promote", "defer", "dismiss", "duplicate"]},
          "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "official_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "checked_at", "availability"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
              "checked_at": {"type": "string", "format": "date-time"},
              "availability": {"enum": ["open", "closed", "future-cycle", "unknown"]},
              "exact_deadline": {"anyOf": [{"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}, {"type": "null"}]},
              "notes_excerpt": {"type": "string", "maxLength": 600}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_kind", "supports_current_opportunity"],
            "properties": {
              "source_kind": {"enum": ["employer", "university", "sponsor", "organization", "other-official"]},
              "supports_current_opportunity": {"type": "boolean"},
              "custom": {"type": "object"}
            }
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conclusion", "basis_codes"],
            "properties": {
              "conclusion": {"enum": ["no-known-hard-failure", "hard-failure", "unknown"]},
              "basis_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "custom": {"type": "object"}
            }
          },
          "duplicate_of": {"type": "string", "pattern": "^opp_[0-9a-f]{32}$"},
          "identity_evidence": {"enum": ["provider-requisition-id", "normalized-official-url", "organization-requisition-id", "exact-composite"]},
          "custom": {"type": "object"}
        },
        "allOf": [{
          "if": {"properties": {"disposition": {"const": "duplicate"}}, "required": ["disposition"]},
          "then": {"required": ["duplicate_of", "identity_evidence"]},
          "else": {"not": {"anyOf": [{"required": ["duplicate_of"]}, {"required": ["identity_evidence"]}]}}
        }]
      }
    },
    "knowledge_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knowledge_id", "statement", "source_refs", "material_effect"],
        "properties": {
          "knowledge_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "statement": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "material_effect": {"enum": ["none", "eligibility", "ranking", "contradiction", "application"]},
          "custom": {"type": "object"}
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposal_id", "protected_target", "summary", "rationale"],
        "properties": {
          "proposal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "protected_target": {"enum": ["engine-code", "source-registry", "schema", "hard-filter", "workspace-instructions"]},
          "summary": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "custom": {"type": "object"}
        }
      }
    }
  }
}
