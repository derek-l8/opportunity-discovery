{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunity-discovery/schemas/review-response.schema.json",
  "title": "Provider-neutral source-backed review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_generation_id", "reviewed_at", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "custom": {"type": "object"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opportunity_id", "disposition", "reason_codes", "official_evidence"],
        "properties": {
          "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-f]{32}$"},
          "disposition": {"enum": ["promote", "defer", "dismiss", "duplicate"]},
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "official_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "checked_at", "availability"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
              "checked_at": {"type": "string", "format": "date-time"},
              "availability": {"enum": ["open", "closed", "future-cycle", "unknown"]},
              "exact_deadline": {
                "anyOf": [
                  {"type": "string", "format": "date"},
                  {"type": "string", "format": "date-time"},
                  {"type": "null"}
                ]
              },
              "notes_excerpt": {"type": "string", "maxLength": 600}
            }
          },
          "duplicate_of": {"type": "string", "pattern": "^opp_[0-9a-f]{32}$"},
          "identity_evidence": {
            "enum": ["provider-requisition-id", "normalized-official-url", "organization-requisition-id", "exact-composite"]
          },
          "custom": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"disposition": {"const": "duplicate"}}, "required": ["disposition"]},
            "then": {"required": ["duplicate_of", "identity_evidence"]},
            "else": {"not": {"anyOf": [{"required": ["duplicate_of"]}, {"required": ["identity_evidence"]}]}}
          }
        ]
      }
    }
  }
}
