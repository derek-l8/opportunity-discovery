{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunity-discovery/schemas/export-manifest.schema.json",
  "title": "Deterministic export generation manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "generation_id",
    "delta_packet_files",
    "configuration",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delta_packet_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^delta_packet(?:\\.p(?:[2-9]|[1-9][0-9]+))?\\.json$"
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "config_filename",
        "config_sha256",
        "source_registry_filename",
        "source_registry_sha256"
      ],
      "properties": {
        "config_filename": {"type": "string"},
        "config_sha256": {"type": ["string", "null"]},
        "source_registry_filename": {"type": "string"},
        "source_registry_sha256": {"type": ["string", "null"]}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "sha256", "bytes"],
        "properties": {
          "filename": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
