{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-application-references.schema.json",
  "title": "Private application source references",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "references": {
      "type": "array",
      "maxItems": 52,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(sources|knowledge)/[^\\\\]+$"},
          "kind": {"enum": ["sources", "knowledge"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
